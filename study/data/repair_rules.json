{
  "repair_rule_dictionary": {
    "version": "v5.1",
    "rules": [
      {
        "repair_rule_id": "RR001",
        "function_name": "standardize_column_names",
        "v4_2_new": false,
        "input_condition": "raw column names contain known synonyms",
        "required_columns": [],
        "required_policy": null,
        "algorithm": "rename source columns to canonical NONMEM names per synonym_map",
        "output_columns": [
          "ID",
          "TIME",
          "AMT",
          "DV",
          "EVID",
          "CMT",
          "MDV"
        ],
        "audit_log_fields": [
          "rule_id",
          "synonym_map_version",
          "renames_applied"
        ],
        "failure_mode": "synonym_map missing",
        "fallback_terminal": "QUARANTINE",
        "fallback_q_code": "Q15A"
      },
      {
