      {
        "repair_rule_id": "RR020",
        "function_name": "canonicalize_cellular_blq",
        "v4_2_new": true,
        "input_condition": "endpoint_data_type=CELLULAR_KINETICS, BLQ events present",
        "required_columns": [
          "ID",
          "TIME",
          "DV",
          "MDV",
          "CMT"
        ],
        "required_policy": "cellular_LLOQ_derivation_policy",
        "algorithm": "1. Read cellular_LLOQ from policy (Poisson-derived value)\n2. For each row with DV < cellular_LLOQ AND EVID=0:\n   - Set MDV=1 if method=M1 (exclude)\n   - Set DV=cellular_LLOQ/2 if method=M3 (cellular subtype)\n3. Append audit_log entry per cellular subtype rule\n",
        "output_columns": [
          "DV",
          "MDV",
          "CELLULAR_BLQ_FLAG"
        ],
        "audit_log_fields": [
          "rule_id",
          "cellular_lloq_value",
          "method",
          "n_blq"
        ],
        "failure_mode": "cellular_LLOQ policy missing or LLOQ value unparseable",
        "fallback_terminal": "QUARANTINE",
        "fallback_q_code": "Q01"
      },
      {
        "repair_rule_id": "RR021",
        "function_name": "adjudicate_immunogenicity_positivity",
        "v4_2_new": true,
        "input_condition": "endpoint_data_type=IMMUNOGENICITY",
        "required_columns": [
          "DV",
          "SCREENING_RESULT"
        ],
        "required_policy": "positivity_adjudication_rule",
        "algorithm": "1. Read rule (screening_only / screening+confirmation / tier_based)\n2. Apply screening cutpoint; samples >= cutpoint go to confirmation tier\n3. Confirmation tier: re-test, declare positive only if confirmed\n4. Tag DV with ADA_POSITIVE_FLAG\n",
        "output_columns": [
          "DV",
          "ADA_POSITIVE_FLAG"
        ],
        "audit_log_fields": [
          "rule_id",
          "rule_used",
          "n_positive",
          "n_negative"
        ],
        "failure_mode": "positivity_adjudication_rule missing",
        "fallback_terminal": "QUARANTINE",
        "fallback_q_code": "Q19"
