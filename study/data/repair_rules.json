        "v4_2_new": true,
        "input_condition": "delivery_date or postpartum_day required as anchor",
        "required_columns": [],
        "required_policy": "delivery_anchor_policy",
        "algorithm": "1. Read anchor (delivery_date / postpartum_day)\n2. TIME = event_datetime - anchor_datetime (in hours)\n3. POSTPARTUM_DAY = ceil(TIME / 24)\n",
